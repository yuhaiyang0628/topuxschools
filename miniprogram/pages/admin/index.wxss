.admin-page {
  padding-top: 62rpx;
  padding-bottom: 80rpx;
}

.admin-title, .editor-title {
  color: #17252b;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.admin-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.header-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 10rpx; flex-shrink: 0; max-width: 430rpx; }

.new-record-action, .review-action, .lead-action, .analytics-action {
  flex-shrink: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
}

.new-record-action { color: #ffffff; background: #0b6276; }
.review-action { color: #0b6276; border: 1rpx solid #a8cbca; background: #ffffff; }
.lead-action { color: #9c4b36; border: 1rpx solid #e5bbae; background: #fff7f3; }
.analytics-action { color: #52636a; border: 1rpx solid #cdd9d7; background: #f4f7f6; }

.admin-copy, .field-hint, .record-meta {
  margin-top: 20rpx;
  color: #6b797e;
  font-size: 25rpx;
  line-height: 1.65;
}

.collection-tabs {
  margin: 42rpx -32rpx 28rpx;
  white-space: nowrap;
}

.tab-track {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.collection-tab, .icon-action, .close-editor, .admin-entry {
  margin: 0;
  border-radius: 8rpx;
  background: #ffffff;
}

.collection-tab {
  min-width: 132rpx;
  height: 70rpx;
  color: #52636a;
  border: 1rpx solid #d4dedc;
  font-size: 27rpx;
  line-height: 68rpx;
}

.collection-tab.active {
  color: #ffffff;
  border-color: #0b6276;
  background: #0b6276;
}

.record-list {
  margin-top: 38rpx;
  border-top: 1rpx solid #dce4e2;
}

.admin-search {
  margin-top: 24rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cfdcda;
  border-radius: 6rpx;
  background: #ffffff;
}

.admin-search input {
  height: 82rpx;
  color: #17252b;
  font-size: 28rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #dce4e2;
}

.record-body { min-width: 0; flex: 1; }
.record-title { color: #17252b; font-size: 29rpx; font-weight: 650; line-height: 1.45; }
.record-meta { margin-top: 8rpx; font-size: 21rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.icon-action, .close-editor { padding: 0 16rpx; color: #0b6276; border: 1rpx solid #b8d3d7; font-size: 23rpx; line-height: 58rpx; }
.icon-action.muted { color: #7a5350; border-color: #e4c8c4; }

.admin-denied { padding-top: 82rpx; }

.editor-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(23, 37, 43, 0.38);
}

.review-mask {
  position: fixed;
  z-index: 21;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(23, 37, 43, 0.38);
}

.editor-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 92vh;
  box-sizing: border-box;
  padding: 34rpx 32rpx 72rpx;
  background: #f7faf9;
  border-radius: 10rpx 10rpx 0 0;
}

.review-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 92vh;
  box-sizing: border-box;
  padding: 34rpx 32rpx 72rpx;
  background: #f7faf9;
  border-radius: 10rpx 10rpx 0 0;
}

.editor-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 30rpx; }
.editor-title { font-size: 40rpx; }
.form-grid { display: flex; gap: 18rpx; }
.form-grid .form-field { min-width: 0; flex: 1; }
.form-field { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #d9e2e0; background: #ffffff; border-radius: 6rpx; }
.field-label { color: #52636a; font-size: 23rpx; font-weight: 650; }
.form-field input, .form-field textarea, .picker-value { min-height: 52rpx; margin-top: 12rpx; color: #17252b; font-size: 28rpx; line-height: 1.5; }
.form-field textarea { width: 100%; }
.picker-value { padding-top: 2rpx; }
.switch-field { display: flex; align-items: center; justify-content: space-between; }
.field-hint { margin-top: 6rpx; font-size: 20rpx; }
.method-option { display: inline-block; margin: 18rpx 24rpx 0 0; color: #304349; font-size: 25rpx; }
.save-button { margin-top: 42rpx; }

.article-media-editor { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #d9e2e0; border-radius: 6rpx; background: #fff; }
.article-media-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.article-media-head > view { min-width: 0; flex: 1; }
.add-media-action { flex-shrink: 0; margin: 0; padding: 0 18rpx; color: #fff; border-radius: 5rpx; background: #0b6276; font-size: 22rpx; line-height: 58rpx; }
.article-media-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #e3e9e7; }
.article-media-preview { width: 112rpx; height: 84rpx; flex-shrink: 0; border-radius: 4rpx; background: #edf2f1; }
.article-media-fields { min-width: 0; flex: 1; }
.article-media-fields input { height: 54rpx; padding: 0 12rpx; border: 1rpx solid #d4dfdc; border-radius: 4rpx; color: #25373d; font-size: 22rpx; }
.article-media-fields input + input { margin-top: 8rpx; }
.remove-media-action { flex-shrink: 0; margin: 0; padding: 0 12rpx; color: #9b3336; border: 1rpx solid #e6b6b3; border-radius: 4rpx; background: #fff; font-size: 20rpx; line-height: 50rpx; }
.article-media-empty { margin-top: 20rpx; }

.review-copy { margin-top: 0; }
.submission-card { margin-top: 22rpx; padding: 24rpx; border: 1rpx solid #d8e3e0; border-radius: 6rpx; background: #ffffff; }
.submission-title { color: #17252b; font-size: 31rpx; font-weight: 700; line-height: 1.4; }
.submission-meta, .submission-contact { margin-top: 10rpx; color: #6b797e; font-size: 21rpx; line-height: 1.5; }
.submission-background { margin-top: 18rpx; color: #304349; font-size: 25rpx; line-height: 1.6; }
.submission-outcomes { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 18rpx; }
.submission-tag { padding: 5rpx 11rpx; border-radius: 999rpx; font-size: 20rpx; background: #eef1f0; color: #52636a; }
.submission-tag.selected { color: #ffffff; background: #0d7a4b; }
.submission-tag.offer { color: #17613d; background: #d9f5e1; }
.submission-tag.rejected { color: #9b3336; background: #fde1e0; }
.submission-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 22rpx; }
.approve-action { color: #ffffff; border-color: #0b7a4c; background: #0b7a4c; }
.lead-status { display: inline-block; margin-bottom: 12rpx; padding: 5rpx 10rpx; color: #0b6276; border: 1rpx solid #afd0d3; border-radius: 4rpx; font-size: 20rpx; }
.lead-status.qualified { color: #17613d; border-color: #a6d4b5; background: #edf8f0; }
.lead-status.closed { color: #6b797e; border-color: #d5dddb; background: #f2f5f4; }
.lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
.lead-grid view { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.lead-grid text:first-child { color: #718086; font-size: 20rpx; }
.lead-grid text:last-child { color: #23353b; font-size: 23rpx; line-height: 1.45; word-break: break-all; }
.analytics-overview { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 8rpx; }
.analytics-overview view { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; border: 1rpx solid #d8e3e0; border-radius: 6rpx; background: #fff; }
.analytics-overview text:first-child { color: #0b6276; font-size: 42rpx; font-weight: 700; }
.analytics-overview text:last-child { color: #718086; font-size: 21rpx; }
.analytics-heading { margin-top: 34rpx; color: #17252b; font-size: 29rpx; font-weight: 700; }
.funnel-list, .search-list { margin-top: 16rpx; border-top: 1rpx solid #d8e3e0; }
.funnel-row, .search-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 4rpx; border-bottom: 1rpx solid #d8e3e0; color: #304349; font-size: 24rpx; }
.funnel-row text:last-child, .search-row text:last-child { color: #0b6276; font-weight: 700; }

.school-editor {
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #cddcda;
  border-radius: 6rpx;
  background: #ffffff;
}

.school-editor-note {
  color: #63737a;
  font-size: 22rpx;
  line-height: 1.6;
}

.school-editor-head, .school-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.school-editor-head {
  margin-top: 26rpx;
  color: #6a7b80;
  font-size: 22rpx;
}

.school-row { margin-top: 16rpx; }
.school-editor-head view:first-child, .school-input-wrap { min-width: 0; flex: 1; }
.school-editor-head view:nth-child(2) { width: 100rpx; }
.school-editor-head view:nth-child(3) { width: 76rpx; }
.school-input-wrap input { height: 68rpx; padding: 0 16rpx; border: 1rpx solid #c8d5d3; border-radius: 4rpx; color: #17252b; font-size: 25rpx; }
.final-row .school-input-wrap input { border-color: #0b8aa0; }
.final-label { margin-top: 8rpx; color: #0b6276; font-size: 19rpx; }
.school-row switch { width: 100rpx; flex-shrink: 0; }
.remove-school, .locked-school { width: 64rpx; height: 64rpx; margin: 0; padding: 0; color: #ffffff; border-radius: 50%; background: #d85c50; font-size: 25rpx; line-height: 64rpx; text-align: center; flex-shrink: 0; }
.locked-school { color: #75858a; border-radius: 0; background: transparent; font-size: 19rpx; }
.add-school { width: 100%; height: 72rpx; margin-top: 28rpx; color: #0b6276; border: 1rpx solid #9bc6cc; border-radius: 6rpx; background: #f7fbfb; font-size: 25rpx; line-height: 70rpx; }
