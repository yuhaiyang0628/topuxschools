<view wx:if="{{caseStudy}}" class="detail-page">
  <view class="detail-hero">
    <view class="detail-topline"><view class="eyebrow">录取案例 · {{caseStudy.year}}</view><help-entry /></view>
    <view class="detail-title">{{caseStudy.title}}</view>
    <view class="detail-school">{{caseStudy.selected.school.schoolCn}}</view>
    <view class="detail-school-en">{{caseStudy.selected.school.school}} · {{caseStudy.selected.program.program}}</view>
    <view class="outcome-tags">
      <text class="outcome-tag {{item.status}}" wx:for="{{caseStudy.outcomes}}" wx:key="label">{{item.label}}</text>
    </view>
  </view>

  <view class="detail-body">
    <view class="section-label">申请背景</view>
    <view class="fact-grid">
      <view class="fact-item" wx:for="{{facts}}" wx:key="label">
        <text class="fact-label">{{item.label}}</text>
        <text class="fact-value">{{item.value}}</text>
      </view>
    </view>

    <block wx:if="{{caseStudy.applicationMethods && caseStudy.applicationMethods.length}}">
      <view class="section-label section-space">申请方式</view>
      <view class="method-tags detail-method-tags">
        <text class="method-tag" wx:for="{{caseStudy.applicationMethods}}" wx:key="*this">{{item}}</text>
      </view>
    </block>

    <view class="section-label section-space">申请结果</view>
    <view class="outcome-tags detail-outcome-tags">
      <text class="outcome-tag {{item.status}}" wx:for="{{caseStudy.outcomes}}" wx:key="label">{{item.label}}</text>
    </view>

    <view class="detail-actions"><button class="favorite-action {{saved ? 'saved' : ''}}" loading="{{savingFavorite}}" bindtap="toggleFavorite">{{saved ? '★ 已收藏' : '☆ 收藏案例'}}</button><button class="share-action" open-type="share">分享案例</button></view>
    <view class="context-cta"><view class="context-kicker">背景对照</view><view class="context-title">想结合自己的背景问问？</view><view class="context-copy">把这个案例发给我，再说一个你最拿不准的问题。我本人回复，不需要先填表。</view><button bindtap="openContact">加微信，把这个案例发给我 →</button></view>
  </view>
  <contact-sheet visible="{{contactOpen}}" source-type="case" source-id="{{caseStudy.id}}" source-title="{{caseStudy.title}}" opening-text="{{contactOpening}}" share-label="把这个案例发给我" bindclose="closeContact" />
</view>
