<view class="page-shell contact-page">
  <view class="eyebrow">Questions &amp; conversation</view>
  <view class="contact-title">有问题，先聊聊再决定。</view>
  <view class="contact-intro">{{contactNote}} 这里由我本人回复，没有销售团队，也不需要先提交背景表。</view>

  <view class="direct-entry">
    <view class="contact-label">主动联系</view>
    <view class="direct-entry-title">带着一个具体问题来聊聊。</view>
    <view class="direct-entry-copy">你不添加，就不会有人联系你。是否需要进一步合作，聊过问题之后再决定。</view>
    <button class="primary-action" bindtap="openContact">查看微信联系方式</button>
  </view>

  <view class="contact-panel">
    <view class="contact-label">邮箱</view>
    <view class="contact-value">{{contactEmail}}</view>
    <button class="primary-action" bindtap="copyEmail">复制邮箱，随意聊聊</button>
  </view>

  <button wx:if="{{isAdmin}}" class="admin-entry" bindtap="openAdmin">运营后台</button>
  <contact-sheet visible="{{contactOpen}}" source-type="contact" opening-text="{{contactOpening}}" share-label="分享 Top UX Schools" bindclose="closeContact" />
</view>
